# ---------------------------------------------------------------------------
# Marketing site. Holds no session, no database and no secrets — if a value
# here ever looks like a credential, it is in the wrong repository.
# ---------------------------------------------------------------------------

# Where the dashboard is deployed. Every "Sign in", "Get started" and "Apply as
# a provider" link points here. Leave empty to keep the links relative, which is
# what a single-origin development setup wants.
# e.g. https://app.trendxcloudsync.com
NEXT_PUBLIC_DASHBOARD_URL=

# The API, as a visitor's browser would reach it. Only used for the status link
# in the footer.
# e.g. https://api.trendxcloudsync.com
NEXT_PUBLIC_API_BASE_URL=

# The API, as this server reaches it while rendering. Defaults to
# NEXT_PUBLIC_API_BASE_URL. Kept separate so it can point somewhere the public
# cannot, and so it is never inlined into the browser bundle.
API_BASE_URL=

# A screenshot of the real dashboard, served from `public/`.
#
# Set it to a path such as `/dashboard-preview.png` and the hero shows the real
# product instead of the schematic chart. Leave it unset until a file is there:
# an image referenced but missing renders as a broken frame on the first thing
# a visitor sees.
#
# Whatever goes in is public forever — account numbers and balances have to be
# out of the frame first.
NEXT_PUBLIC_DASHBOARD_PREVIEW=
